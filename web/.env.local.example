# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Both are public by design (shipped in the browser bundle) and read nothing without an
# approved login, because row-level security limits reads to public.allowed_users.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
